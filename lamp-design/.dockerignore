# Build context hygiene: keep the image small and keep weights out of it.

# The trained ensemble DOES belong in the image: it ships inside the package
# at src/lamp_design/weights/ and is 2.8 MB. Do not add *.pt / weights/
# patterns back -- that leaves the image with no model.
checkpoints/
*.ckpt

# Local environments and caches
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# VCS and editor state
.git/
.gitignore
.github/
.idea/
.vscode/
*.swp

# Run outputs and local data
runs/
outputs/
*.diagnostics.json

# Docker itself
Dockerfile
.dockerignore
