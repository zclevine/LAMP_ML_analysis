# The portal image with a compressing, caching reverse proxy in front.
#
# Optional. `Dockerfile.portal` at the repo root is the plain one and is what
# the main docs describe; this is the variant to deploy if first-load time
# matters. See README.md in this directory for the measurements.
#
# Build (needs the portal image first):
#   docker build -t lamp-design:cpu .
#   docker build -t lamp-design:portal -f Dockerfile.portal .
#   docker build -t lamp-design:portal-fast -f deploy/streamlit/perf/Dockerfile.proxied .
#
# Run:
#   docker run --rm -p 8080:8080 -v /path/to/weights:/weights:ro \
#     lamp-design:portal-fast

FROM lamp-design:portal

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends nginx \
    && rm -rf /var/lib/apt/lists/*

COPY deploy/streamlit/perf/nginx.conf /etc/nginx/nginx.conf

# nginx takes $PORT (Cloud Run's contract); Streamlit moves to a private port
# that is never published.
ENV STREAMLIT_SERVER_PORT=8501
EXPOSE 8080

# Both processes, with the container exiting if either dies -- a proxy whose
# backend has gone is worse than no container, because health checks pass while
# every request 502s.
COPY deploy/streamlit/perf/start.sh /usr/local/bin/start-proxied.sh
RUN chmod +x /usr/local/bin/start-proxied.sh \
    && mkdir -p /var/cache/nginx && chown -R 1000:1000 /var/cache/nginx /var/log/nginx /var/lib/nginx

CMD ["/usr/local/bin/start-proxied.sh"]
