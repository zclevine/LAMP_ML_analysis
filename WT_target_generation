    def add_blocks(self,n_blocks,len_block):
        
        
        #define function for selecting coordinates 
        def get_rand_coord(self):
            rcoord = self.sample_radius + 1
            while np.linalg.norm(rcoord) > self.sample_radius:
                rcoord = np.random.uniform(-1 * self.sample_radius, self.sample_radius,
                                           size=self.n_comp)
            return rcoord
        
        #initate empty seq object 
        self.seq = "" 
        self.coords_list = []
        self.block_seqs = []
        
        for b in range(n_blocks) :
            if b == 0 : #if its the first base you must seed 
                self.seq += np.random.choice(list("ACGT")) #seed with random 

                end_point = len_block - 1 
            else :
                end_point = len_block

            # select random coordations from the PCA
            pca_coords = get_rand_coord(self)
            #add the coords to the list 
            self.coords_list.append(pca_coords)
            
            #inverse transform and inverse scale the coords 
            comp_app_scaled = scaler.inverse_transform(self.pca.inverse_transform(pca_coords).reshape(1, -1)).reshape(4,4)
            pmat = comp_app_scaled / np.sum(comp_app_scaled, axis=1, keepdims=True)


            # fill in the block 
            for i in range(0,end_point) : 

                probs = pmat[self.b2i[self.seq[-1]],:].copy()
                self.seq += "".join(np.random.choice(list("ACGT"), p=probs)) #add the new base by making a random choice with the probabilities 

            #add the block seq to the list 
            self.block_seqs.append(self.seq[-len_block:])
            
        return self.seq, self.coords_list, self.block_seqs

    
    
