# The portal in a box: the Streamlit UI, served the way PrimerCast serves its.
#
# `Dockerfile` (the CLI image) is for Snakemake and batch use, and deliberately
# has no server in it. This one adds Streamlit on top of that exact image, so
# the engine, the pinned dependency solve and the build-time tool checks are
# inherited rather than repeated.
#
# The contract below is copied from PrimerCast's Dockerfile on purpose, so this
# drops into the same Cloud Run + Terraform setup with no new deployment story:
#
#   * listens on $PORT, defaulting to 8080
#   * binds 0.0.0.0, headless, usage stats off
#   * EXPOSE 8080
#
# Build (the CLI image first -- this one FROMs it):
#   docker build -t lamp-design:cpu .
#   docker build -t lamp-design:portal -f Dockerfile.portal .
#
# Run locally:
#   docker run --rm -p 8080:8080 \
#     -v /host/path/checkpoints:/weights:ro \
#     lamp-design:portal
#
# -----------------------------------------------------------------------------
# READ THIS BEFORE DEPLOYING TO CLOUD RUN
#
# With LAMP_DESIGN_BACKEND=local (the default here) a design run happens inside
# this container, synchronously. Measured on the shipped demo panel (10 x ~1.7
# kb H5N1 HA, stride 1): see docs/ARCHITECTURE.md for the CPU figure. It is far
# longer than PrimerCast's ~10 s per run, and PrimerCast's Cloud Run service is
# configured with a 600 s per-request timeout on 4 CPU.
#
# So: do not deploy this as a synchronous Cloud Run service at stride 1 without
# checking the CPU number against your timeout first. The two supported shapes
# are
#
#   1. LAMP_DESIGN_BACKEND=modal -- this container serves only the UI and polls
#      a GPU elsewhere, so each HTTP request is milliseconds. This is the
#      recommended shape and the reason the Modal path exists.
#   2. LAMP_DESIGN_BACKEND=local with a coarser --stride, sized so a run fits
#      the request timeout. Cheaper to operate, coarser tiling.
# -----------------------------------------------------------------------------

FROM lamp-design:cpu

LABEL org.opencontainers.image.description="ML-guided LAMP primer set design -- Streamlit portal"

USER root
# Streamlit only. Everything the engine needs is already solved in the base
# image, and `--no-deps` would strip Streamlit's own tree, so this is a plain
# install held to a known-good minor.
RUN pip install --no-cache-dir "streamlit>=1.65,<2" \
    && python -c "import streamlit; print('streamlit', streamlit.__version__)"
USER $MAMBA_USER

# Same four as PrimerCast, so behaviour matches theirs on Cloud Run.
ENV STREAMLIT_SERVER_PORT=8080 \
    STREAMLIT_SERVER_ADDRESS=0.0.0.0 \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Streamlit buffers an entire upload in memory before the app sees a byte, so
# the server cap matters independently of the app's own 5 MB check. Keep the
# two equal -- see deploy/streamlit/README.md.
ENV STREAMLIT_SERVER_MAX_UPLOAD_SIZE=5

# `local` runs the engine in this container; `modal` makes it a thin client.
ENV LAMP_DESIGN_BACKEND=local

# Verify the app imports under the real interpreter. Catches a missing
# dependency or a syntax error at build time rather than on first page load --
# the same gap that let `einops` ship broken.
RUN python -c "import sys; sys.path.insert(0, '/app/deploy/streamlit'); import _backend, _layout, _engine_api; print('portal modules import')"

EXPOSE 8080

WORKDIR /app
CMD ["sh", "-c", "exec streamlit run --server.port=${PORT:-8080} --server.address=0.0.0.0 /app/deploy/streamlit/app.py"]
